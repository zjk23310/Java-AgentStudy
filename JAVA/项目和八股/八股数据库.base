views:
  - type: table
    name: 视图
    filters:
      and:
        - file.inFolder("JAVA")
        - file.ext != "base"
    order:
      - file.name
      - tags
      - 复习时间
      - 掌握
    sort:
      - property: 复习时间
        direction: DESC
      - property: tags
        direction: DESC
      - property: 掌握
        direction: ASC
