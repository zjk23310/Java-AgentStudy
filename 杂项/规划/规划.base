views:
  - type: table
    name: 视图
    filters:
      and:
        - file.inFolder("杂项/规划")
        - file.ext != "base"
    order:
      - file.name
      - created
      - deadLine
      - 完成日期
      - 最新复习时间
      - 掌握
      - 进度
    sort:
      - property: 完成日期
        direction: ASC
      - property: created
        direction: DESC
    columnSize:
      note.完成日期: 112
