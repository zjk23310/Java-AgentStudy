views:
  - type: table
    name: 视图
    filters:
      and:
        - file.inFolder("算法")
    order:
      - file.name
      - tags
      - 掌握
      - 复习时间
      - summary
      - 难度
    sort:
      - property: 掌握
        direction: ASC
      - property: 复习时间
        direction: DESC
    columnSize:
      file.name: 203
      note.tags: 229
      note.summary: 457
      note.难度: 92
      note.掌握: 87
